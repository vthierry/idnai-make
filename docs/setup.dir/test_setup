#!/bin/bash

# Private usage: test_setup ; Tests the setup and install mechanism installing the idnai-test package

## Cd in the sketchbook
cd `dirname $0`/../../../

## If true works in a sketchbook/sketchbook_sandox 
sandbox=true

## Cleans previous local repository files
sudo /bin/rm -rf sketchbook_sandox
if ! $sandbox
then
  for f in ./{node_modules,package.json,package-lock.json} idnai-test*
  do sudo /bin/rm -rf $f
  done
fi
## Rebuilds the file bundle
make -C idnai-make -B docs/setup.dir/setup.zip

## Cleans idnia-test remote files
  git clone --quiet git@github.com:vthierry/idnai-test.git
  cd idnai-test
  for f in .gitignore bin docs LICENSE makefile* node_modules package* README.md src
  do (chmod u+w $f ; git rm --quiet -rf $f ; /bin/rm -rf $f) 2>/dev/null
  done
  git commit --quiet -a -m 'Test repository reset' 2>/dev/null
  git push --quiet
  cd ..
  /bin/rm -rf idnai-test

## Works in a sandbox if reequired
if $sandox
then setup="../idnai-make/docs/setup" ; mkdir sketchbook_sandox ; cd sketchbook_sandox
else setup="./idnai-make/docs/setup" 
fi

## Runs the setup
echo -e "yyvthierry\nidnai-test\n" | $setup
cd idnai-test
