#!/usr/bin/env node

if (process.argv.length > 2 && ["-h", "--help"].includes(process.argv[2]) || process.argv.length != 3) {
  console.log(`
Usage: urlexists $url
- Returns an empty string if the URL is available, else the HTTP response status.
`);
  exit();
}

fetch(process.argv[2], { method: "HEAD" }).then((response) => {
  if (!response.ok)
    console.log(response.status);
});


