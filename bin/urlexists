#!/usr/bin/env node

if (process.argv.length > 2 && ["-h", "--help"].includes(process.argv[2]) || process.argv.length != 3) {
  console.log(`
Usage: urlexists $url
Returns:
- If the URL is available: 'true' (i.e. exit 0) with no output.
- Otherwise: 'false' (i.e. exit 1) and echo the HTTP response status or the fetch error code.
`);
  process.exit();
}

fetch(process.argv[2], { method: "HEAD", signal: AbortSignal.timeout(5000) }).
  then(response => { if (response != undefined && response.ok) { process.exit(0); } else { console.log(response.status); }}).
  catch(error => { console.log((""+error.cause).
    replace(new RegExp(".*INVALID_URL.*", "gs"), "Invalid URL").
    replace(new RegExp(".*ENOTFOUND.*", "gs"), "Web site not found")); });
process.exit(1);
