#!/bin/bash

if [ "$1" = -h -o "$1" = --help ]
then cat <<EOU
Usage: clean [\$directory…]
Cleans all standard temporary files.
- The default directory is \`.\`.
- Also cleans \`/tmp/*~\` user's files, used by contract in scripts, and left temporary for debugging.
EOU
exit
fi

clean()
{
  find "$*" \( -type f -o -type d \) -a \( \
     -name '#*' -o \
     -name '.#*' -o \
     -name '*%' -o \
     -name '.*%' -o \
     -name '*~' -o \
     -name '.*~' -o \
     -name '*.stdout' -o \
     -name '*.stderr' -o \
     -name '*.undo-*' -o \
     -name '*.bak' -o \
     -name '.*.bak' -o \
     -name '*.log' -o \
     -name 'nohup.out' -o \
     -name 'a.out' -o \
     -name 'a.cmd' -o \
     -name '*.o'  -o \
     -name '*.aux' -o \
     -name '*.toc' -o \
     -name '*.ind' -o \
     -name '*.blg' -o \
     -name '*.bbl' -o \
     -name '*.dvi' -o \
     -name '*.lof' -o \
     -name '*.log' -o \
     -name '*.ilg' -o \
     -name '*.nav' -o \
     -name '*.spl' -o \
     -name '*.snm' -o \
     -name '*.sol' \) \
     -exec /bin/rm -rf {} \; 2>/dev/null
}

cleantmp() {
  find /tmp -user $USER -name '*~' -exec /bin/rm -rf {} \; 2>/dev/null
}

cleantmp
if [ -z "$*" ]
then clean "."
else for d in $* ; do clean $d ; done
fi
