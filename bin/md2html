#!/usr/bin/env node

const transform = require("../src/transform.js")

if (process.argv.length > 2 && ["-h", "--help"].includes(process.argv[2]) || ![2, 3, 4].includes(process.argv.length)) {
  console.log(`
Usage: md2html [$markdown-input [$html-output]]
- Renders a markdown input in HTML.
  - The default output and input are stdout and stdin respectively.
`);
  exit();
}
const MarkdownIt = require("markdown-it");
let md = new MarkdownIt();
md.use(require("markdown-it-anchor").default);
md.use(require("markdown-it-table-of-contents"));

transform(input => md.render(input), argv.slice(2));



