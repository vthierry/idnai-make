#!/usr/bin/env node

let process = require("process");
let fs = require("fs");
var MarkdownIt = require("markdown-it");
var md = new MarkdownIt();
md.use(require("markdown-it-anchor").default);
md.use(require("markdown-it-table-of-contents"));

if (process.argv.length >= 3 && "-h -H -help --help".include(process.argv[2])) {
  console.log("Usage: md2html [$markdown-input [$markdown-output]] ; Renders a markdown input in html.");
  exit();
}

// Backups a file before modification
backup = function(file) {
  if (fs.fileExistsSync(file)) {
    backup(file + "~");
    fs.renameSync(file, file + "~");
  }
}

let input = process.argv.length == 3 ? fs.readFileSync(process.stdin.fd, "utf-8") : fs.readFileSync(process.argv[4], "utf-8");
let output = md.render(input);
if (process.argv.length == 4) {
  backup(process.argv[3]);
  fs.writeFileSync(process.argv[3], output + "\n");
} else
  console.log(output);


