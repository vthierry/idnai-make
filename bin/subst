#!/usr/bin/env node

const fs = require("fs");

if (process.argv.length > 2 && ["-h", "--help"].includes(process.argv[2]) || ![4, 5, 6].includes(process.argv.length)) {
  console.log(`
Usage: subst $pattern $replacement [$input [$output]]
Replaces a string using Javascript regular expressions.
- The newline is treated as a standard char.
- The default output and input are stdout and stdin respectively.
- The input and output can be the same file.
`);
  process.exit();
}

// Implements a textual transform `output = transform(input)` managing $input $output, with file backup
function transform(transform, argv) {
  const error = function(message) {
    throw new Error(message);
  };
  const bakfile = function(file) {
    if (fs.existsSync(file)) {
      bakfile(file + "~");
      fs.renameSync(file, file + "~");
    }
  };
  let input =
      argv.length == 0 ? fs.readFileSync("/dev/stdin", "utf-8") :
      fs.existsSync(argv[0]) ? fs.readFileSync(argv[0], "utf-8") :
      error(`File not found: '${argv[0]}'`);
  let output = transform(input);
  if (argv.length == 2) {
    bakfile(argv[1]);
    fs.writeFileSync(argv[1], output);
  } else
    console.log(output);
}

transform(input => input.replace(new RegExp(process.argv[2], "gs"), process.argv[3]).trim(), process.argv.slice(4));
