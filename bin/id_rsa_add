#!/bin/bash

## Reinstalls a ssh-agent if not in the environment (when using a key shortcut)
if ssh-add -l 2>&1 | grep 'Could not open a connection to your authentication agent.' >/dev/null
then ssh-agent > /tmp/$$~ ; . /tmp/$$~
fi      

## Redefines an identity if not yet defined.
if ssh-add -l 2>&1 | grep 'The agent has no identities.' >/dev/null
then ssh-add
fi

## Checks if the .ssh/id_rsa is added
if [ -f "~/.ssh/id_rsa.pub" ] && ! ssh-add -L 2>/dev/null | grep "^`cat ~/.ssh/id_rsa.pub`$" > /dev/null
then echo 'Warning: the .ssh/id_rsa is not added'
fi
