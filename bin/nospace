#!/bin/bash

if [ -z "$1" -o "$1" = -h -o "$1" = --help ]
then cat <<EOU
Usage: nospace [-R] \$filename_or_directory
Renames file name without blank or hiding-dot.
  - Echoes the renamed file name.
Option:
  -R: Changes files and directories recursively.
EOU
exit
fi

if [ "$1" = -R ]
then
  shift
  d="`nospace $*`"
  if [ -d "$d" ]
  then
    pushd $d >/dev/null
    ls -1 | sed 's/^/nospace -R /' > /tmp/nospace$$.txt
    bash /tmp/nospace$$.txt
    /bin/rm /tmp/nospace$$.txt
    popd > /dev/null
  fi
else
  f="`echo $* | sed 's/ /_/g' | sed 's/^\/\./\//g'`"
  if [ "$*" \!= "$f" ] ; then mv "$*" "$f" ; fi
  echo "$f"
fi


