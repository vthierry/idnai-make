#!/bin/bash

usage() {
  cat <<EOU
  Usage: nospace [-R] \$filename_or_directory
Renames file name without blank or hiding-dot.
  - Echoes the renamed file name.
Option:
  -R: Changes files and directories recursively.
EOU
}

while true ; do case "$1" in
  -R ) rec=true ; shift ;;	  
  "" | -* | -h | --help ) usage ; exit ;;
  * ) break;
esac ; done

if [ -z "$rec" ]
then
  f="`echo $* | sed "s/[ !]/_/g" | sed "s/'/´/g" | sed 's/"/¨/g' | sed 's/^\/\./\//g'`"
  if [ "$*" \!= "$f" ] ; then mv "$*" "$f" ; fi
else
  d="`nospace $*`"
  if [ -d "$d" ]
  then
    pushd $d >/dev/null
    ls -1 | sed 's/"/\\"/g' | sed 's/^\(.*\)/nospace -R "\1"/' > /tmp/$$~
    bash /tmp/$$~
    popd > /dev/null
  fi
fi


