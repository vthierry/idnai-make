#!/bin/bash
needfor arp-scan

usage() {
  cat <<EOU
Usage: isItOn [[\$what=\$mac|\$what|\$mac] [[-b [\$port]] | -c \$what] | -e]
- Outputs the IP address of a device if it is on the network, else nothing.
  - mac: A MAC address, with a proper syntax.
     - The form '\$what=\$mac' registers a MAC address under a short-name, for subsequent calls.
  - what: A short-name associated to a registered MAC address.
- Options:
  - -b: Opens the http://\$IP[:\$port] home-page in the default \$BROWSER, if defined, for the \$IP address, if defined, on either the given or the default port.
  - -c: Checks if the '\$what' is registered, output the related MAC address if yes, and true or false accordingly, without network scan.
  - -e: Edits, with the default \$EDITOR, the '.isItOn' file with '\$what=\$mac' definitions, and exit.
- Examples:
  - The construct 'if isItOn \$what > /dev/null ; then …` detects if the device is on the network or not.
    - The script returns true or false accordingly.
  - The construct 'if [ -z "\`isItOn \$what ; then …` detects if the device is on the network or not.
- Notes:
  - If the \$EDITOR or \$BROWSER environment variable is not set, the related option is silently discarded.
  - The MAC expected address syntax is 'xx:xx:xx:xx:xx:xx' where 'x' stands for an hexadecimal digit.
  - If '\$what' is an unknown short-name, stderr gets an error message, stdout remains empty, and it exists without error.
EOU
}

## Manages the MACS<what,MAC> associative table.
declare -A MACS
setMAC() { ### Adds a new assignment to the table.
  if [[ "$1" =~ ^[A-Za-z0-9_]+=([a-f0-9]{2}:){5}[a-f0-9]{2}$ ]]
  then
    what="`echo $1 | sed 's/=.*$//'`"
    MAC="`echo $1 | sed 's/^[^=]*=//'`"
    MACS["$what"]="$MAC"
    true
  else
    false
  fi
}
### Loads existing assignments.
data="`dirname $0`/.isItOn"
touch $data ; while read line ; do setMAC $line ; done < $data

## Manages the command options.
if [ -z "$1" -o "$1" = -h -o "$1" = --help ]
then usage ; exit
elif [ "$1" = -e ]
then if [ \! -z "$EDITOR" ] ; then $EDITOR $data ; exit ; fi
elif [ "$1" = -c ]
then if [ -v MACS["$what"] ] ; then echo "${MACS["$what"]}" ; true ; else false ; fi ; exit
elif [[ "$1" =~ ^([a-f0-9]{2}:){5}[a-f0-9]{2}$ ]] ### A MAC address is given directly, no assignment.
then MAC="$1" 
else
  if setMAC "$1"
  then ### A new assignment is given.
    what="`echo $1 | sed 's/=.*$//'`"
    #### Updates the assignments file, suppressing previous $what assignment, if any, then appending the new one.
    mv $data $data~ ; (grep -v "^$what=" < $data~ ; echo "$1") > $data
  else
    what="$1" ### A hopefully existing short-name is given.
  fi
  ### Sets the related MAC address if any.
  if [ -v MACS["$what"] ]
  then MAC="${MACS["$what"]}"
  else >&2 echo "Unknown short-name '$1'." ; exit
  fi
fi

## Retrieves the IP from the MAC address, if online on the local network.
IP="`sudo arp-scan -lqx | grep "$MAC" | awk '{print $1}'`" ; echo $IP

## Opens the browser, if defined, for the IP address, if defined, on the default or given port.
if [ \! -z "$BROWSER" -a \! -z "$IP" -a "$2" = -b ]
then if [ -z "$3" ] ; then $BROWSER http://$IP ; else $BROWSER http://$IP:$3 ; fi
fi

## Returns true or false
if [ -z "$IP" ] ; then false ; else true ; fi

