#!/bin/bash

if [ -z "$1" -o "$1" = -h -o "$1" = --help ]
then cat <<EOU
Usage: confirm \$message [\$exit_message]
- Asks a true/false question
  - Returns the boolean answer if no exit message.
  - Exits with error 1 if false and \$exit_message is set.
EOU
exit
fi

read -p "$1? (y/N) : " -n 1 -e rep
if [ "$rep" = "y" ] ; then
  true
else
  if [ \! -z "$exit_message" ] ; then
    echo "$exit_message" ; exit 1 ;
  fi
  false
fi

