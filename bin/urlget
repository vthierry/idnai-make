#!/usr/bin/env node

let process = require("process");
let fs = require("fs");

if (process.argv.length != 3 && process.argv.length != 4) {
  console.log("Usage: urlget $url [$file] ; Saves the url page in a file or stdout, if available, else echo the http status.");
  exit();
}

// Backups a file before modification
backup = function(file) {
  if (fs.fileExistsSync(file)) {
    backup(file + "~");
    fs.renameSync(file, file + "~");
  }
}

fetch(process.argv[2]).then((response) => {
  if (!response.ok) {
    console.log("Error http: " + response.statusText + " (" + response.status + ")");
  } else if (process.argv.length == 4) {
    backup(process.argv[3]);
    fs.writeFileSync(process.argv[3], response.text());
  } else {
    console.log(response.text());
  }
});
