#!/usr/bin/env node

const transform = require("../src/transform.js")

if (process.argv.length > 2 && ["-h", "--help"].includes(process.argv[2]) || ![3, 4].includes(process.argv.length)) {
  console.log(`
Usage: urlget $url [$file]
- Saves the URL unique page, if available, in a file or on stdout, else echo the HTTP status.
`);
  exit();
}

fetch(process.argv[2]).then((response) => {
  if (!response.ok) {
    console.error("Error http: " + response.statusText + " (" + response.status + ")");
  } else {
    transform((input) => response, process.argv.length == 4 ? [ "", process.argv[3] ] : [ "" ]);
  }
});
