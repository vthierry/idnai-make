#!/usr/bin/env node

const fs = require("fs");
const path = require("path");

const { inspect } = require('node:util');

if (process.argv.length > 2 && ["-h", "--help"].includes(process.argv[2]) || ![3, 4].includes(process.argv.length)) {
  console.log(`
Usage: urlget $url [$file|-]
Saves the URL page, if available, in a file.
- Its saves only one web page.
- The output file default name is given by the URL basename.
- The URL page is output on stdout, if using \`-\` as second argument.
`);
  process.exit();
}

try {
  if (process.argv.length == 4 && process.argv[3] == "-") {
    fetch(process.argv[2], { signal: AbortSignal.timeout(5000) } ).
      then(response => {
	if (!response.ok) {
	  console.error("Error http: " + response.statusText + " (" + response.status + ")");
	  process.exit(1);
	} else {
	  return response.text();
	}
      }).
      then(console.log);
  } else {
    fetch(process.argv[2], {
      method: 'GET',
      headers: {
	'Content-Type': 'application/octet-stream'
      },
      responseType: 'arraybuffer',
      signal: AbortSignal.timeout(5000)
    }).
      then(response => {
	// console.dir(response, { depth: null }); // allows to dump the whole response tree
	if (!response.ok) {
	  console.error("Error http: " + response.statusText + " (" + response.status + ")");
	  process.exit(1);
	} else {
	  return response.arrayBuffer();
	}
      }).
      then(arraybuffer => {
	let output = process.argv.length == 4 ? process.argv[3] : process.argv[2].replace(new RegExp(".*/"), "");
	const bakfile = function(file) {
	  if (fs.existsSync(file)) {
	    bakfile(file + "~");
	    fs.renameSync(file, file + "~");
	  }
	};
	bakfile(output);
	fs.mkdirSync(path.dirname(output), { recursive: true }, e => { if (e) throw e; });
	fs.writeFile(output, Buffer.from(arraybuffer), e => { if (e) throw e; });
      });
  }
} catch(error) {
  console.log(error);
}




