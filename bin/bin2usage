#!/bin/bash

if [ \~ -z "$*" ]
then cat <<EOF
  Internal usage: bin2usage ; generates a `bin/Usages.md` file from available scripts.
  By contract, each script usage must have a one-line documentation of the form:
     Usage: $calling-sequence ; $short-description
  to generates the `Usage.md` file.
EOF


(echo "<!-- THIS FILE IS AUTOMATICALLY GENERATED, BETTER NOT EDIT -->" ;\
 echo -e "# Avalaible usages:\n" ;\
 if [ -f "makefile" ] ; then echo -ne "- " ; make usage ; fi ;\
 (for f in `find $PWD \( -path "$HOME/.bashrc" -o -path "$PWD/bin/[a-z_0-9]*" -o -path "$PWD/node_modules/*/bin/[a-z_0-9]*" \)`
 do
   if grep '^ *Usage *:' $f >/dev/null
   then sed -n 's/ *\(Usage *:.*\)/- \1/p' < $f
   elif grep '# *Usage *:' $f >/dev/null
   then sed -n 's/[^#]*# *\(Usage *:.*\)/- \1/p' < $f
   elif grep '" *Usage *:' $f >/dev/null
   then sed -n 's/[^"]*" *\(Usage *:[^"]*\).*/- \1/p' < $f
   fi
 done) | sort -u) > bin/Usages.md


